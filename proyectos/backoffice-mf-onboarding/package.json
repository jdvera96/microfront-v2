{
  "name": "backoffice-mf-onboarding",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "preview": "ng serve --configuration=production",
    "postinstall": "node ../tools/patch-native-federation.mjs",
    "mf:serve:ng": "ng serve --port 4202",
    "mf:serve": "node ./dev-proxy.mjs",
